generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Student {
  id             Int      @id @default(autoincrement())
  name           String
  email          String?  @unique
  school         String?
  major          String?

  resumeText     String?
  portfolioText  String?
  stuckOn        String?

  creatorType    String?
  skills         String?
  neededSkills   String?
  neededRoles    String?
  motivation     String?

  availability   Int?
  rolePreference String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}