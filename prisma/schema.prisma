generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["matching"]
}

model Student {
  id             Int      @id @default(autoincrement())
  name           String
  email          String?  @unique
  school         String?
  major          String?

  resumeText     String?
  portfolioText  String?
  stuckOn        String?

  creatorType    String?
  skills         String?
  neededSkills   String?
  neededRoles    String?
  motivation     String?

  availability   Int?
  rolePreference String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sentInterests     Interest[] @relation("SentInterests")
  receivedInterests Interest[] @relation("ReceivedInterests")

  @@schema("matching")
}

model Interest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("interested")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   Student @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Student @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@schema("matching")
}